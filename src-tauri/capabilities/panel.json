{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Panneau : réglages, approbations et journal des actions, banc de mesure",
  "windows": ["panel"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-panel-close",
    "allow-settings-get",
    "allow-settings-save",
    "allow-tool-resolve",
    "allow-tool-undo",
    "allow-journal-list",
    "allow-agenda-between",
    "allow-agenda-month-days",
    "allow-agenda-create",
    "allow-agenda-delete",
    "allow-reminders-list",
    "allow-reminders-create",
    "allow-reminders-complete",
    "allow-reminders-delete",
    "allow-notes-list",
    "allow-notes-create",
    "allow-notes-pin",
    "allow-notes-delete",
    "allow-notes-to-reminder",
    "allow-timers-list",
    "allow-timers-start",
    "allow-focus-start",
    "allow-timers-cancel",
    "allow-clipboard-list",
    "allow-clipboard-pin",
    "allow-clipboard-delete",
    "allow-clipboard-paste",
    "allow-weather-get",
    "allow-index-status",
    "allow-perf-frame",
    "allow-perf-open-cycles"
  ]
}
