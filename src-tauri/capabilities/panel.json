{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Panneau : réglages, approbations et journal des actions, banc de mesure",
  "windows": ["panel"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-panel-close",
    "allow-settings-get",
    "allow-settings-save",
    "allow-tool-resolve",
    "allow-tool-undo",
    "allow-journal-list",
    "allow-perf-frame",
    "allow-perf-open-cycles"
  ]
}
