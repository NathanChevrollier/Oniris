{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pill",
  "description": "Pilule : ouvrir/fermer le panneau, se redimensionner, lire les réglages",
  "windows": ["pill"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-panel-open",
    "allow-panel-close",
    "allow-panel-toggle",
    "allow-pill-resize",
    "allow-settings-get",
    "allow-timers-list"
  ]
}
